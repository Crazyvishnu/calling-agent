# Do not commit credentials to Git. No API keys needed for local demo.
AGENT_DB_PATH=backend/data/leads.sqlite3
# Install this LOCAL model separately; never select a cloud model.
OLLAMA_MODEL=qwen3:1.7b
# Ollama must also inherit this setting when its own server is started.
OLLAMA_NO_CLOUD=1
# Optional local speech: install backend/requirements-speech.txt and explicitly
# run python -m scripts.setup_speech --download first. Defaults are English only.
STT_MODEL_PATH=backend/models/whisper-base.en
STT_LANGUAGES=en
PIPER_VOICE_EN_PATH=backend/models/en_US-ljspeech-high.onnx
# Tune for actual CPU availability; warm-up and inference use the same options.
OLLAMA_NUM_THREADS=2
# Private Linux AudioSocket lab is explicitly disabled by default. No PSTN route.
AKKI_SIP_LAB=0
# Optional overrides; defaults resolve these paths from the project directory.
# AKKI_SIP_CREDENTIALS_PATH=telephony/runtime/credentials.json
# AKKI_SIP_RELAY_PATH=telephony/runtime/ipc/audio.sock

# Owner and optional named team access (required for remote access); generate a random 32+ character key.
# AKKI_ADMIN_KEY=
# Optional private JSON: account name -> {role: operator/viewer, key: unique random 32+ characters}.
# Never expose this JSON to frontend builds or commit actual keys.
AKKI_TEAM_KEYS={}
# AKKI_ALLOWED_ORIGINS=https://your-private-dashboard.example
# AKKI_SECURE_COOKIES=1
# Optional Telegram outbox, disabled by default. Explicit worker command sends one item.
AKKI_TELEGRAM_ENABLED=0
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Private lab rolling-24-hour quota, clamped to 1..10; no carrier calling.
AKKI_PRIVATE_DAILY_LIMIT=5
